# Generated integration files — run scripts/convert.sh to regenerate locally
# The scripts/ and integrations/*/README.md files ARE committed; only generated
# agent/skill files are excluded.
integrations/antigravity/agency-*/
integrations/gemini-cli/skills/
integrations/gemini-cli/gemini-extension.json
integrations/gemini-cli/agents
integrations/opencode/agents/
integrations/cursor/rules/
integrations/aider/CONVENTIONS.md
integrations/windsurf/.windsurfrules
integrations/openclaw/*
integrations/qwen/agents/
integrations/kimi/*/
!integrations/openclaw/README.md
!integrations/kimi/README.md
integrations/codex/agents/*
integrations/osaurus/agency-*/
integrations/hermes/agency-agents-router/
integrations/vibe/agents/
integrations/vibe/prompts/
integrations/zcode/agents/
graphify-out/

# Netlify build output (assembled by scripts/build-netlify-site.sh)
site/
# ...except the two dashboards whose sites are COMMITTED rather than built on
# Netlify. Their Netlify projects run no build step -- baby-scout/netlify.toml
# and growth-scout/netlify.toml only assert that site/index.html exists and
# publish the folder -- so a site/ that git ignores is a site that never
# deploys.
!baby-scout/site/
!growth-scout/site/

# Tailwind toolchain for the Netlify site build
scripts/netlify/node_modules/
# …but the Netlify build toolchain pins its versions, so that lockfile is tracked.
!scripts/netlify/package-lock.json

# Sweep output: a CI artifact, not source
research-board/candidates.json

# Funding sweep scratch output (funding.json itself IS tracked — it's the feed)
funding-scraper/sweep.log

# deep-research working files
/research_notes/
/reports/
